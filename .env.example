# Settings for the Everybody's Golf Online server. setup.py writes .env from this file;
# without it, copy this file to .env and fill in the two values marked "required".

# Required: the address players' consoles reach this machine at (LAN address for players at
# home, the internet address or a name for it otherwise). The register and gate servers hand
# it to the client for the next server.
MINGOL_PUBLIC_IP=

# Required: the token an OpenLobby admin panel sends (setup makes one at random).
MINGOL_ADMIN_TOKEN=

# Players with a different route to this machine (a LAN and the internet) can each be handed
# their own address: CIDR=address pairs, first match wins, e.g.
#   192.168.0.0/16=192.168.0.10,0.0.0.0/0=203.0.113.7
# This needs the players' real addresses, which Docker Desktop hides: Linux only.
#MINGOL_ADVERTISE_MAP=

# The news line players see when they sign in (the admin panel can change it).
MINGOL_NEWS=Welcome to Everybody's Golf Online!

# 1 = accept any password (accounts are still made per console key and in-game ID).
#MINGOL_NO_PASSWORD_CHECK=

# The Feega service the admin panel's player lookup asks (empty turns it off), and its token
# when it wants one.
#MINGOL_FEEGA_URL=http://feega:24030
#MINGOL_FEEGA_TOKEN=

# The GitHub repository whose releases the admin panel's update notice compares this build
# with (owner/name; empty turns the check off).
#MINGOL_UPDATE_REPO=PSChuze/golfforeverybody

# Where accounts and logs are kept on this machine.
#MINGOL_STATE=./state

# The secret an OpenLobby panel gave at pairing (setup keeps it here).
#OPENLOBBY_PAIRING=
